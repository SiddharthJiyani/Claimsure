# ============================================================
# Claimsure Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# ----- Server -----------------------------------------------
PORT=5001
NODE_ENV=development

# Set to "true" to skip real external API calls (safe for demos)
DRY_RUN=false

# ----- Supabase ---------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----- AI Server --------------------------------------------
AI_SERVER_URL=http://localhost:8000
AI_SERVER_TIMEOUT_MS=30000

# ----- Google OAuth / Service Account -----------------------
# For personal @gmail.com accounts, use OAuth2. This makes uploads use your own
# Drive quota instead of the service account's zero storage quota.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/oauth2callback
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token

# Service accounts still work for Workspace Shared Drives.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Path to service account JSON key file (relative to server/)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# Google Drive folder ID where all case evidence is stored
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Google Sheets ID for live case mirror dashboard
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Google Calendar ID for appeal deadlines
GOOGLE_CALENDAR_ID=your_calendar_id_here

# Gmail sender address (must match service account or OAuth creds)
GMAIL_SENDER_EMAIL=noreply@yourapp.com

# SMTP fallback (used when all SMTP values are configured)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourapp.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# ----- Slack ------------------------------------------------
# Incoming webhook is enough for channel updates (recommended).
# Slack app → Incoming Webhooks → Add to #claimsure-updates → copy URL.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
SLACK_CHANNEL_NAME=claimsure-updates
# Optional bot (interactive Approve / Reject buttons)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=xapp-your-slack-app-level-token
SLACK_APPROVAL_CHANNEL_ID=C0XXXXXXXXX

# ----- Rate Limiting ----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- CORS -------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
